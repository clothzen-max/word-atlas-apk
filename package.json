{
  "name": "word-atlas-apk",
  "version": "1.0.0",
  "private": true,
  "description": "把 designfuchen/word-atlas（词光）打成 Android APK 的 Capacitor 壳工程",
  "type": "module",
  "scripts": {
    "web": "node scripts/build-web.mjs",
    "native:add": "cap add android",
    "native:sync": "cap sync android",
    "apk": "cd android && ./gradlew assembleDebug",
    "all": "npm run web && npm run native:add && npm run apk",
    "slim": "node scripts/slim.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/core": "^7.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.0.0",
    "typescript": "^5.9.3",
    "sharp": "^0.33.5"
  }
}